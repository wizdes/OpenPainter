<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable><LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PdnSource Condition="'$(PdnSource)' == ''">../../.pdn-src</PdnSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Png.cs" />
    <Compile Include="Stubs/*.cs" />
    <Compile Include="Shims/*.cs" />
    <Compile Include="Generated/FloodExtract.cs" />
    <Compile Include="$(PdnSource)/src/Core/ColorBgra.cs" />
    <Compile Include="$(PdnSource)/src/Base/IDeferredSerializable.cs" />
    <Compile Include="$(PdnSource)/src/Base/DeferredFormatter.cs" />
    <Compile Include="$(PdnSource)/src/Core/Scanline.cs" />
    <Compile Include="$(PdnSource)/src/Core/RgbColor.cs" />
    <Compile Include="$(PdnSource)/src/Core/Surface.cs" />
    <Compile Include="$(PdnSource)/src/Core/MemoryBlock.cs" />
    <Compile Include="$(PdnSource)/src/Core/PixelOp.cs" />
    <Compile Include="$(PdnSource)/src/Core/IPixelOp.cs" />
    <Compile Include="$(PdnSource)/src/Core/UnaryPixelOp.cs" />
    <Compile Include="$(PdnSource)/src/Core/BinaryPixelOp.cs" />
    <Compile Include="$(PdnSource)/src/Core/UnaryPixelOps.cs" />
    <Compile Include="$(PdnSource)/src/Core/BinaryPixelOps.cs" />
    <Compile Include="$(PdnSource)/src/Core/HsvColor.cs" />
    <Compile Include="$(PdnSource)/src/Core/Histogram.cs" />
    <Compile Include="$(PdnSource)/src/Core/HistogramRGB.cs" />
    <Compile Include="$(PdnSource)/src/Core/SplineInterpolator.cs" />
    <Compile Include="$(PdnSource)/src/Core/ResamplingAlgorithm.cs" />
    <Compile Include="$(PdnSource)/src/Data/UserBlendOps.cs" />
    <Compile Include="$(PdnSource)/src/Data/UserBlendOp.cs" />
    <Compile Include="$(PdnSource)/src/Data/UserBlendOps.Generated.cs" />
    <Compile Include="$(PdnSource)/src/Effects/BrightnessAndContrastAdjustment.cs" />
    <Compile Include="$(PdnSource)/src/Effects/PosterizeAdjustment.cs" />
    <Compile Include="$(PdnSource)/src/Effects/GaussianBlurEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/FragmentEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/LocalHistogramEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/MedianEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/MotionBlurEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/RadialBlurEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/ZoomBlurEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/ReduceNoiseEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/GlowEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/RedEyeRemoveEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/SharpenEffect.cs" />
    <Compile Include="$(PdnSource)/src/Effects/SoftenPortraitEffect.cs" />
  </ItemGroup>
  <Target Name="ExtractLegacyFlood" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract-flood.py&quot;" />
  </Target>
</Project>
