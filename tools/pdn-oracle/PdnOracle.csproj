<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable><LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PdnSourceRoot Condition="'$(PdnSourceRoot)' == ''">../../.pdn-src/src</PdnSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Png.cs" />
    <Compile Include="Stubs/*.cs" />
    <Compile Include="Shims/*.cs" />
    <Compile Include="Generated/FloodExtract.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/ColorBgra.cs" />
    <Compile Include="$(PdnSourceRoot)/Base/IDeferredSerializable.cs" />
    <Compile Include="$(PdnSourceRoot)/Base/DeferredFormatter.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/Scanline.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/RgbColor.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/Surface.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/MemoryBlock.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/PixelOp.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/IPixelOp.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/UnaryPixelOp.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/BinaryPixelOp.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/UnaryPixelOps.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/BinaryPixelOps.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/HsvColor.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/Histogram.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/HistogramRGB.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/SplineInterpolator.cs" />
    <Compile Include="$(PdnSourceRoot)/Core/ResamplingAlgorithm.cs" />
    <Compile Include="$(PdnSourceRoot)/Data/UserBlendOps.cs" />
    <Compile Include="$(PdnSourceRoot)/Data/UserBlendOp.cs" />
    <Compile Include="$(PdnSourceRoot)/Data/UserBlendOps.Generated.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/BrightnessAndContrastAdjustment.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/PosterizeAdjustment.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/GaussianBlurEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/FragmentEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/LocalHistogramEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/MedianEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/MotionBlurEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/RadialBlurEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/ZoomBlurEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/BulgeEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/PixelateEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/PolarInversionEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/TileEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/TwistEffect.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/WarpEffectBase.cs" />
    <Compile Include="$(PdnSourceRoot)/Effects/WarpEdgeBehavior.cs" />
  </ItemGroup>
  <Target Name="ExtractLegacyFlood" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract-flood.py&quot;" />
  </Target>
</Project>
