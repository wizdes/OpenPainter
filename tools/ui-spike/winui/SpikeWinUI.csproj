<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishAot>true</PublishAot>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../engine/target/release/op_ffi.dll" Link="op_ffi.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../engine/target/release/op_ffi.dll')" />
  </ItemGroup>
</Project>
