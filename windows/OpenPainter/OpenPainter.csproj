<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>src/app.manifest</ApplicationManifest>
    <RootNamespace>OpenPainter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- W6's look files are the one source of colors, sizes and control helpers. -->
    <Compile Include="../../tools/ui-look/app/src/Tokens.cs" Link="src/Look/Tokens.cs" />
    <Compile Include="../../tools/ui-look/app/src/Icons.cs" Link="src/Look/Icons.cs" />
    <Compile Include="../../tools/ui-look/app/src/Ui.cs" Link="src/Look/Ui.cs" />
    <EmbeddedResource Include="../assets/catalog/mac-catalog.json" LogicalName="mac-catalog.json" />
    <Content Include="../assets/icons/*.svg" Link="assets/icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/icons/16/*.svg" Link="assets/icons/16/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../assets/icons/12/*.svg" Link="assets/icons/12/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../engine/target/release/op_ffi.dll" Link="op_ffi.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../engine/target/release/op_ffi.dll')" />
  </ItemGroup>
</Project>
